<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Claudio.App.CardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Claudio.App"
    Title="Claudio">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Card" Padding="16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <local:MascotView x:Name="Mascot" Width="29" Height="27" />
        <TextBlock Text="Claudio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <Border x:Name="BadgePill" Grid.Column="2" CornerRadius="9" Padding="7,2" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="Badge" FontSize="10" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <TextBlock Grid.Row="1" x:Name="Caption" Margin="0,14,0,0" Opacity="0.55" FontSize="10"
               FontWeight="SemiBold" CharacterSpacing="90" Text="SESSION · 5H" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2">
      <TextBlock x:Name="Percent" Text="—" FontSize="34" FontWeight="SemiBold" />
      <TextBlock x:Name="PercentSign" Text="%" FontSize="15" Opacity="0.45" VerticalAlignment="Bottom"
                 Margin="0,0,0,7" Visibility="Collapsed" />
    </StackPanel>

    <TextBlock Grid.Row="3" x:Name="Detail" Margin="0,2,0,0" Opacity="0.6" FontSize="11"
               TextWrapping="Wrap" Text="Reading your account…" />
  </Grid>
</Window>
