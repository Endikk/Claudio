<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Claudio.App.CardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Claudio.App"
    Title="Claudio">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Card" Padding="16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <local:MascotView x:Name="Mascot" Width="29" Height="27" />
      <TextBlock Text="Claudio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal" Spacing="2">
      <TextBlock x:Name="Percent" Text="—" FontSize="34" FontWeight="SemiBold" />
    </StackPanel>

    <TextBlock Grid.Row="2" x:Name="Caption" Margin="0,4,0,0" Opacity="0.55" FontSize="11"
               Text="Session · 5h" />
  </Grid>
</Window>
